uint16_t getCommandCode(MenuState menu, int index) {
  switch (menu) {
    case MEDIA_MENU:   return 100 + index;
    case KB_LETTERS:   return 200 + index;
    case KB_SPECIAL:   return 300 + index;
    case KB_NAV:       return 400 + index;
    case KB_MODIFIERS: return 500 + index;
    case KB_FUNC:      return 600 + index;
    default: return 0;
  }
}

String codeLabel(uint16_t code) {
  int group = code / 100;
  int idx = code % 100;
  switch (group) {
    case 1: if (idx < ARRAY_LEN(mediaItems))  return mediaItems[idx]; break;
    case 2: if (idx < ARRAY_LEN(kbLetters))   return kbLetters[idx]; break;
    case 3: if (idx < ARRAY_LEN(kbSpecial))   return kbSpecial[idx]; break;
    case 4: if (idx < ARRAY_LEN(kbNav))       return kbNav[idx]; break;
    case 5: if (code == 503) return "Win";
            if (idx < ARRAY_LEN(kbModifiers)) return kbModifiers[idx]; break;
    case 6: if (idx < ARRAY_LEN(kbFunc))      return kbFunc[idx]; break;
  }
  return "?";
}

// Kisayolun adi: "Ctrl+C", "Alt+F4", "Enter" ...
String keysLabel(const Keys& k) {
  String s = "";
  for (size_t i = 0; i < k.size(); i++) {
    if (i) s += "+";
    s += codeLabel(k[i]);
  }
  return s;
}

String bindingLabel(int i) {
  return bindings[i].empty() ? String("Yok") : keysLabel(bindings[i]);
}

// Menudeki bir ogenin gonderecegi tuslar (yapisal ogeler icin bos doner)
Keys keysForItem(MenuState menu, int index) {
  Keys k;
  if (menu == KB_COMBO) {
    if (index >= 1 && index <= (int)combos.size()) k = combos[index - 1];
  } else {
    uint16_t code = getCommandCode(menu, index);
    if (code) k.push_back(code);
  }
  return k;
}

// ------------------------------------------------------------
// Kalici hafiza (NVS)
// ------------------------------------------------------------
std::vector<uint8_t> packList(const std::vector<Keys>& list) {
  std::vector<uint8_t> out;
  for (const Keys& k : list) {
    out.push_back((uint8_t)k.size());
    for (uint16_t c : k) {
      out.push_back(c & 0xFF);
      out.push_back((c >> 8) & 0xFF);
    }
  }
  return out;
}

std::vector<Keys> unpackList(const uint8_t* d, size_t len) {
  std::vector<Keys> list;
  size_t i = 0;
  while (i < len) {
    uint8_t n = d[i++];
    if (n > MAX_KEYS || i + (size_t)n * 2 > len) break;
    Keys k;
    for (uint8_t j = 0; j < n; j++) {
      k.push_back((uint16_t)(d[i] | (d[i + 1] << 8)));
      i += 2;
    }
    list.push_back(k);
  }
  return list;
}

void saveList(const char* key, const std::vector<Keys>& list) {
  std::vector<uint8_t> buf = packList(list);
  prefs.begin("mkey", false);
  if (buf.empty()) prefs.remove(key);
  else prefs.putBytes(key, buf.data(), buf.size());
  prefs.end();
}

bool loadList(const char* key, std::vector<Keys>& out) {
  prefs.begin("mkey", false);
  size_t len = prefs.getBytesLength(key);
  bool ok = len > 0;
  if (ok) {
    std::vector<uint8_t> buf(len);
    prefs.getBytes(key, buf.data(), len);
    out = unpackList(buf.data(), len);
  }
  prefs.end();
  return ok;
}

